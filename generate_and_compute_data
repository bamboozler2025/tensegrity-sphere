import math
import Rhino.Geometry as rg

# Note: 'twist', 'v', 'Ro', 'Ri', 'cable_target' are now expected as component inputs

def generate_and_compute_data(v, Ro, Ri, twist_deg, target_len):
    v = int(v)
    if v < 2 or v % 2 != 0: return [], [], [], [], [], [], [], [], [], [], [], [], [], [], []

    # 1. GENERATE GEODESIC DATA TABLE
    data_table = []
    index = 0
    for H in [0, 1]:
        for Q in [0, 1, 2, 3]:
            for R in range(v + 1):
                if R == 0:
                    row = [index, H, Q, R, 0, "{}{}{}{}".format(H, Q, "{:02d}".format(R), "{:02d}".format(0))]
                    data_table.append(row)
                    index += 1
                else:
                    for L in range(R):
                        row = [index, H, Q, R, L, "{}{}{}{}".format(H, Q, "{:02d}".format(R), "{:02d}".format(L))]
                        data_table.append(row)
                        index += 1

    # 2. GENERATE REFERENCE POINTS
    ref_points = []
    for row in data_table:
        _, H, Q, R, L, _ = row
        Offset = Ro
        if R == 0:
            XY_angle = 0; Z_angle = 0
        else:
            if H == 0:
                xo = R/v * (1 - L/R); yo = R/v * L/R; zo = (v - R)/v
                XY_angle = math.acos(xo / (xo**2 + yo**2)**0.5) + (Q * math.pi / 2)
                Z_angle = math.acos(zo / (xo**2 + yo**2 + zo**2)**0.5)
            else:
                xo = R/v * (1 - L/R); yo = R/v * L/R; zo = (v - R)/v
                XY_angle = math.pi - math.acos(xo / (xo**2 + yo**2)**0.5) - (Q * math.pi / 2)
                Z_angle = math.pi - math.acos(zo / (xo**2 + yo**2 + zo**2)**0.5)
        
        x = Offset * math.cos(XY_angle) * math.sin(Z_angle)
        y = Offset * math.sin(XY_angle) * math.sin(Z_angle)
        z = Offset * math.cos(Z_angle)
        ref_points.append(rg.Point3d(x, y, z))

    name_to_idx = {row[5]: row[0] for row in data_table}

    # 3. DEFINE TOPOLOGY
    Atriangles = [] 
    for H in [0, 1]:
        for Q in [1, 3]:
            p1 = "{}{}{:02d}{:02d}".format(H, Q, 1, 0)
            p2 = "{}{}{:02d}{:02d}".format(H, Q, 2, 1)
            Q3 = Q+1 if Q+1 < 4 else 0
            p3 = "{}{}{:02d}{:02d}".format(H, Q3, 1, 0)
            Atriangles.append([p1, p2, p3])
    for Ra in range(2, v, 2):
        for j in range(1, Ra, 2):
            for H in [0, 1]:
                for Q in [0, 2]:
                    p1 = "{}{}{:02d}{:02d}".format(H, Q, Ra, j)
                    p2 = "{}{}{:02d}{:02d}".format(H, Q, Ra + 1, j)
                    p3 = "{}{}{:02d}{:02d}".format(H, Q, Ra + 1, j+1)
                    Atriangles.append([p1, p2, p3])
    for Ra in range(3, v, 2):
        for j in range(2, Ra + 2, 2):
            for H in [0, 1]:
                for Q in [1, 3]:
                    p1 = "{}{}{:02d}{:02d}".format(H, Q , Ra, j - 2)
                    if H==0: Q2=Q; L2=j-1; H2=0
                    else:
                        if Ra == v-1: Q2=(1-Q)%4; L2=v-j+1; H2=0
                        else: Q2=Q; L2=j-1; H2=H
                    p2 = "{}{}{:02d}{:02d}".format(H2, Q2, Ra + 1, L2)
                    Q3 = Q if j < Ra else (Q + 1 if Q + 1 < 4 else 0)
                    L3 = j - 1 if j < Ra else 0
                    p3 = "{}{}{:02d}{:02d}".format(H, Q3, Ra, L3)
                    Atriangles.append([p1, p2, p3])

    Btriangles = [] 
    for H in [0, 1]:
        for Q in [0, 2]:
            p1 = "{}{}{:02d}{:02d}".format(H, Q, 1, 0)
            p2 = "{}{}{:02d}{:02d}".format(H, Q, 2, 1)
            p3 = "{}{}{:02d}{:02d}".format(H, Q+1, 1, 0)
            Btriangles.append([p1, p2, p3])
    for Ra in range(2, v, 2):
        for j in range(1, Ra, 2):
            for H in [0, 1]:
                for Q in [1, 3]:
                    p1 = "{}{}{:02d}{:02d}".format(H, Q, Ra, j)
                    p2 = "{}{}{:02d}{:02d}".format(H, Q, Ra + 1, j)
                    p3 = "{}{}{:02d}{:02d}".format(H, Q, Ra + 1, j+1)
                    Btriangles.append([p1, p2, p3])
    for Ra in range(3, v, 2):
        for j in range(2, Ra + 2, 2):
            for H in [0, 1]:
                for Q in [0, 2]:
                    p1 = "{}{}{:02d}{:02d}".format(H, Q , Ra, j - 2)
                    if H==0: Q2=Q; L2=j-1; H2=0
                    else:
                        if Ra == v-1: Q2=(1-Q)%4; L2=v-j+1; H2=0
                        else: Q2=Q; L2=j-1; H2=H
                    p2 = "{}{}{:02d}{:02d}".format(H2, Q2, Ra + 1, L2)
                    Q3 = Q if j < Ra else (Q + 1 if Q + 1 < 4 else 0)
                    L3 = j - 1 if j < Ra else 0
                    p3 = "{}{}{:02d}{:02d}".format(H, Q3, Ra, L3)
                    Btriangles.append([p1, p2, p3])

    # 4. TWISTING & SMART SCALING LOGIC
    def get_smart_transformed_pts(pt_list, angle_deg, target_mean_len):
        center = rg.Point3d(0,0,0)
        for p in pt_list: center += p
        center /= len(pt_list)
        
        # Calculate Current Mean Length
        current_len_sum = 0
        for i in range(len(pt_list)):
            p1 = pt_list[i]
            p2 = pt_list[(i+1)%len(pt_list)]
            current_len_sum += p1.DistanceTo(p2)
        
        current_mean = current_len_sum / len(pt_list)
        
        # Calculate Scale Factor needed for THIS triangle
        if current_mean > 0.001:
            local_scale = target_mean_len / current_mean
        else:
            local_scale = 1.0 # Safety for degenerate triangles
            
        # 1. Twist Transform
        axis = rg.Vector3d(center)
        rot = rg.Transform.Rotation(math.radians(angle_deg), axis, center)
        
        # 2. Scale Transform (Using locally calculated factor)
        scl = rg.Transform.Scale(center, local_scale)
        
        # Combined Transform
        final_xform = rot * scl
        
        new_pts = []
        for p in pt_list:
            new_p = rg.Point3d(p)
            new_p.Transform(final_xform)
            new_pts.append(new_p)
        return new_pts

    outer_pt_map = {} 
    inner_pt_map = {} 

    # --- OUTER LAYER (Twist A-Triangles CLOCKWISE) ---
    e = [] 
    for tri in Atriangles:
        raw_pts = [ref_points[name_to_idx[n]] for n in tri if n in name_to_idx]
        if len(raw_pts) == 3:
            # Scale exactly to 'target_len'
            pts_out = get_smart_transformed_pts(raw_pts, -twist_deg, target_len)
            
            e.append(rg.Polyline(pts_out + [pts_out[0]]))
            for name, final_pt in zip(tri, pts_out):
                outer_pt_map[name] = final_pt

    # --- INNER LAYER (Twist B-Triangles ANTI-CLOCKWISE) ---
    h = [] 
    scale_ri = Ri / Ro
    
    # FIX: Use same target length for Inner as Outer (Fixed component size)
    inner_target_len = target_len 
    
    for tri in Btriangles:
        raw_pts = [rg.Point3d(ref_points[name_to_idx[n]]) for n in tri if n in name_to_idx]
        for p in raw_pts:
            p.X *= scale_ri; p.Y *= scale_ri; p.Z *= scale_ri
            
        if len(raw_pts) == 3:
            # Scale exactly to 'target_len' (was inner_target_len)
            pts_in = get_smart_transformed_pts(raw_pts, twist_deg, inner_target_len)
            
            h.append(rg.Polyline(pts_in + [pts_in[0]]))
            for name, final_pt in zip(tri, pts_in):
                inner_pt_map[name] = final_pt

    # 5. GENERATE MEMBERS
    poles_CL = []
    PILT = []
    SILT = []
    
    B_lookup = {}
    for k, tri_B in enumerate(Btriangles):
        for name in tri_B:
            if name not in B_lookup: B_lookup[name] = []
            B_lookup[name].append(tri_B)

    for i, tri_A in enumerate(Atriangles):
        for j in range(3):
            A_name = tri_A[j]
            next_A_name = tri_A[(j+1)%3]
            
            if A_name not in outer_pt_map: continue
            pt_outer = outer_pt_map[A_name]

            # Poles
            if next_A_name in B_lookup:
                for tri_B in B_lookup[next_A_name]:
                    idx_in_B = tri_B.index(next_A_name)
                    target_idx = (idx_in_B + 1) % 3
                    target_name = tri_B[target_idx]
                    
                    if target_name in inner_pt_map:
                        pt_inner_pole = inner_pt_map[target_name]
                        poles_CL.append(rg.Line(pt_outer, pt_inner_pole))
                        pt_inner_silt = inner_pt_map[next_A_name]
                        SILT.append(rg.Line(pt_outer, pt_inner_silt))
                        break

            # PILT
            if A_name in B_lookup:
                for tri_B in B_lookup[A_name]:
                    idx_in_B = tri_B.index(A_name)
                    target_idx = (idx_in_B + 1) % 3
                    target_name = tri_B[target_idx]
                    
                    if target_name in inner_pt_map:
                        pt_inner_pilt = inner_pt_map[target_name]
                        PILT.append(rg.Line(pt_outer, pt_inner_pilt))
                        break

    # Binding Cables
    g = []
    for tri in Btriangles:
        pts = [outer_pt_map[n] for n in tri if n in outer_pt_map]
        if len(pts) == 3: g.append(rg.Polyline(pts + [pts[0]]))

    i_polys = []
    for tri in Atriangles:
        pts = [inner_pt_map[n] for n in tri if n in inner_pt_map]
        if len(pts) == 3: i_polys.append(rg.Polyline(pts + [pts[0]]))

    # 6. BASIS POINTS
    BasList = []
    b_lim = (v ** 2) // 4; count = 0
    for R in range(1, v + 1):
        if count >= b_lim: break
        if R % 2 != 0:
            for i in range(1, R + 1):
                if count >= b_lim: break
                L = R // 2 + (i // 2) * (-1) ** i
                for Q in [1, 0]:
                    if count >= b_lim: break
                    BasList.append("0{}{:02}{:02}".format(Q, R, L)); count += 1
        else:
            for i in range(1, (R // 2) + 1):
                if count >= b_lim: break
                L = -(-(R / 2) // 2) * 2 - 1 + (2 * (i // 2)*(-1) ** i) * (-1) ** (R / 2)
                for Q in [1, 0]:
                    if count >= b_lim: break
                    BasList.append("0{}{:02}{:02}".format(Q, R, int(L))); count += 1
    
    m = []
    for n in BasList:
        if n in outer_pt_map: m.append(outer_pt_map[n])
            
    mi = []
    for n in BasList:
        if n in inner_pt_map: mi.append(inner_pt_map[n])

    a, b = data_table, ['Headers']
    c, ci = ref_points, [] 
    d, f = Atriangles, Btriangles
    i = i_polys 
    j = poles_CL
    k = PILT
    l = SILT

    return a, b, c, ci, d, e, f, g, h, i, j, k, l, m, mi

try:
    if 'twist' not in globals() or twist is None: twist = 30
    if 'v' not in globals() or v is None: v = 10
    if 'Ro' not in globals() or Ro is None: Ro = 13000
    if 'Ri' not in globals() or Ri is None: Ri = 11200
    if 'cable_target' not in globals() or cable_target is None: cable_target = 1374
        
    a, b, c, ci, d, e, f, g, h, i, j, k, l, m, mi = generate_and_compute_data(v, Ro, Ri, twist, cable_target)
except Exception as ex:
    print("Error:", ex)
    a=b=c=ci=d=e=f=g=h=i=j=k=l=m=mi = []
